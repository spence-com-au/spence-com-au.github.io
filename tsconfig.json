{
  "compilerOptions": {
    "target": "ES2023",

    // Node's globals alone, since Node runs `scripts/` and the configs beside this one. `src/tsconfig.json` swaps them
    // for the browser's and Vite's, and `tests/tsconfig.json` adds the browser's, so no code type-checks against
    // globals its runtime lacks.
    "lib": ["ES2023"],
    "types": ["node"],

    // `nodenext` because Node runs `scripts/` as it stands, and its resolver is the one that makes a missing extension
    // an error rather than a module that type-checks and then fails to load. Vite resolves the same specifiers.
    "module": "nodenext",
    "moduleResolution": "nodenext",

    // Node strips the types from `scripts/` rather than compiling them, so nothing here may need a compiler to emit.
    "erasableSyntaxOnly": true,
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "noEmit": true,

    "jsx": "react-jsx",
    "resolveJsonModule": true,
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "skipLibCheck": true
  },
  "include": ["scripts", "*.ts"]
}
