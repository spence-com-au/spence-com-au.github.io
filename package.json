{
  "name": "spence-com-au.github.io",
  "type": "module",
  "private": true,
  "scripts": {
    "build": "node scripts/build.ts",
    "dev": "vite",
    "fetch:repos": "node scripts/fetch-repos.ts",
    "lint": "npm-run-all --continue-on-error --parallel --print-label 'lint:!(fix)'",
    "lint:css": "stylelint '**/*.css'",
    "lint:css:fix": "stylelint --fix '**/*.css'",
    "lint:fix": "npm-run-all --print-label --serial 'lint:*:fix'",
    "lint:html": "pnpm build fixtures/repos.json --outDir dist/fixture && html-validate dist/fixture",
    "lint:js": "eslint .",
    "lint:js:fix": "eslint --fix .",
    "lint:prettier": "prettier --check .",
    "lint:prettier:fix": "prettier --write .",
    "lint:types": "tsc -b . src tests",
    "preview": "vite preview",
    "render:logos": "node scripts/render-logos.ts",
    "test": "vitest run",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@fontsource-variable/martian-mono": "5.3.0",
    "@xterm/xterm": "6.0.0",
    "culori": "4.0.2",
    "node-html-parser": "9.0.7",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "v86": "0.5.473"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.65.0",
    "@resvg/resvg-js": "2.6.2",
    "@stylistic/eslint-plugin": "5.10.0",
    "@types/culori": "4.0.1",
    "@types/node": "^24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.2.1",
    "eslint": "10.14.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-react-hooks": "7.1.1",
    "html-validate": "11.19.0",
    "npm-run-all2": "9.0.4",
    "prettier": "3.9.10",
    "stylelint": "17.16.0",
    "stylelint-config-standard": "40.0.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "vite": "8.3.5",
    "vitest": "5.1.0"
  },
  "packageManager": "pnpm@12.14.0",
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "^24.0.0",
      "onFail": "download"
    }
  }
}
