{
  "name": "spence-com-au.github.io",
  "type": "module",
  "private": true,
  "scripts": {
    "build": "node scripts/build.mjs",
    "lint": "npm-run-all --continue-on-error --parallel --print-label 'lint:!(fix)'",
    "lint:fix": "npm-run-all --print-label --serial lint:prettier:fix",
    "lint:prettier": "prettier --check .",
    "lint:prettier:fix": "prettier --write ."
  },
  "devDependencies": {
    "npm-run-all2": "^9.0.3",
    "prettier": "3.9.10"
  },
  "packageManager": "pnpm@12.14.0",
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "^24.0.0",
      "onFail": "download"
    }
  }
}
